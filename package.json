{
  "name": "faster-reads",
  "version": "0.9.0",
  "description": "A privacy-conscious Chrome extension that adds visual anchors to selected webpage text.",
  "private": true,
  "license": "MIT",
  "author": "Shayan Shojaei",
  "homepage": "https://shayan-shojaei.github.io/faster-reads/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shayan-shojaei/faster-reads.git"
  },
  "bugs": {
    "url": "https://github.com/shayan-shojaei/faster-reads/issues"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "lint": "eslint . && oxlint --deny-warnings --vitest-plugin entrypoints utils tests wxt.config.ts vitest.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:package": "node scripts/validate-package.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run zip && npm run validate:package"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.3.0",
    "eslint": "10.11.0",
    "happy-dom": "20.14.5",
    "oxlint": "1.85.0",
    "prettier": "3.9.9",
    "rollup": "4.63.5",
    "typescript": "7.0.2",
    "vitest": "5.0.2",
    "wxt": "0.21.4"
  }
}
